# Copy to backend/.env and adjust. All variables are optional.

# Skip every DNS lookup; all three checks then report `not_checked`.
# Useful for demoing without a network.
MAILFORGE_OFFLINE=false

# Resolvers used for SPF/DKIM/DMARC lookups. Comma-separated.
# Set to `system` to use the machine's own resolver instead.
MAILFORGE_DNS_SERVERS=1.1.1.1,8.8.8.8,9.9.9.9

# DNS timing budgets, in seconds.
MAILFORGE_DNS_QUERY_TIMEOUT=2.5
MAILFORGE_DNS_TIMEOUT=6.0
MAILFORGE_SPF_QUERYTIME=20.0

# Maximum accepted upload size, in bytes (default 25 MB).
MAILFORGE_MAX_UPLOAD_BYTES=26214400

# Origins allowed to call the API from a browser. Comma-separated.
MAILFORGE_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
